# Supabase — project URL and keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose. Used by route handlers that need elevated access.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-side only, never exposed to the client (spec §2)
ANTHROPIC_API_KEY=

# USDA FoodData Central — free API key (https://fdc.nal.usda.gov/api-key-signup.html)
# Open Food Facts needs no key.
USDA_API_KEY=
